  .wrap{max-width:1000px;margin:0 auto;padding:32px 26px;}
  h1{font-size:28px;margin:0 0 4px;color:#fff;}
  .sub{color:#94a3b8;font-size:14px;margin-bottom:16px;}
  section{background:#1e293b;border-radius:12px;padding:18px 20px;margin:14px 0;border-left:5px solid #6366f1;}
  h2{font-size:18px;margin:0 0 10px;color:#c7d2fe;}
  table{border-collapse:collapse;width:100%;font-size:14px;}
  th,td{border:1px solid #334155;padding:8px 10px;text-align:left;}
