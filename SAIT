<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Допуск — прогноз готовности к сессии</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-deep:   #0B1F3A;
    --navy:        #12294D;
    --blue:        #1B4B91;
    --blue-mid:    #4C7FD1;
    --blue-tint:   #C3D9F7;
    --accent:      #F5B942;
    --accent-dark: #C98F1E;
    --paper:       #F3F6FC;
    --paper-line:  #D6E1F2;
    --white:       #FFFFFF;
    --ink:         #12294D;
    --ink-soft:    #4C5F7D;
    --danger:      #C7433F;
    --ok:          #2E7D5B;
  }

  *{ box-sizing:border-box; }

  html{ font-size:18px; }

  html,body{
    margin:0; padding:0;
    height:100%;
    width:100%;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    scroll-behavior:smooth;
    overflow-x:hidden;
  }

  h1,h2,h3, .display{
    font-family:'Fraunces', serif;
    font-weight:500;
    line-height:1.15;
    margin:0;
  }

  a{ color:inherit; }

  button{
    font-family:'Inter', sans-serif;
    cursor:pointer;
    border:none;
  }

  button:focus-visible, input:focus-visible, select:focus-visible{
    outline:2px solid var(--blue-mid);
    outline-offset:2px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
  }

  .page{ display:none; min-height:100vh; width:100%; }
  .page.active{ display:block; }

  /* ---------- PAGE 1: HERO ---------- */

  #page-hero{
    background:
      radial-gradient(1200px 680px at 82% -8%, rgba(76,127,209,0.38), transparent 60%),
      radial-gradient(760px 480px at 90% 72%, rgba(245,185,66,0.20), transparent 65%),
      linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 100%);
    color:var(--white);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:72px 24px;
  }

  .hero-shell{
    max-width:1160px;
    width:100%;
    display:grid;
    grid-template-columns:1fr;
    gap:56px;
    align-items:center;
  }

  @media (min-width:900px){
    .hero-shell{ grid-template-columns:1.05fr 0.95fr; }
  }

  .hero-text{ max-width:600px; }

  .brand-badge{
    position:relative;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:4px 8px;
    margin-bottom:34px;
    opacity:0;
    animation: rise 0.7s ease-out 0.05s forwards;
  }
  .laurel{
    position:absolute;
    top:50%; left:50%;
    transform:translate(-50%,-50%);
    width:190px; height:auto;
    z-index:0;
    pointer-events:none;
  }
  .brand{
    position:relative;
    z-index:1;
    font-family:'Fraunces', serif;
    font-size:1.2rem;
    letter-spacing:0.02em;
    color:var(--blue-tint);
  }

  .hero-greeting{
    font-size:clamp(2.3rem, 5vw, 3.6rem);
    color:var(--white);
    opacity:0;
    animation: rise 0.7s ease-out 0.15s forwards;
  }

  .hero-sub{
    margin-top:22px;
    font-size:1.18rem;
    line-height:1.6;
    color:#D3E0F5;
    max-width:500px;
    opacity:0;
    animation: rise 0.7s ease-out 0.3s forwards;
  }

  @keyframes rise{
    from{ opacity:0; transform:translateY(14px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .btn-primary{
    margin-top:34px;
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:var(--accent);
    color:var(--navy-deep);
    padding:16px 30px;
    border-radius:8px;
    font-size:1.08rem;
    font-weight:600;
    text-decoration:none;
    transition: background 0.15s ease, transform 0.15s ease;
    opacity:0;
    animation: rise 0.7s ease-out 0.45s forwards;
  }
  .btn-primary:hover{ background:#FFC968; transform:translateY(-1px); }
  .btn-primary:active{ transform:translateY(0); }

  .btn-primary svg{ flex-shrink:0; }

  .download-note{
    margin-top:12px;
    font-size:0.9rem;
    color:#9BB4DC;
    opacity:0;
    animation: rise 0.7s ease-out 0.5s forwards;
  }

  /* how it works steps */
  .steps{
    margin-top:46px;
    display:flex;
    flex-direction:column;
    gap:22px;
    padding-left:22px;
    border-left:2px solid rgba(245,185,66,0.35);
    opacity:0;
    animation: rise 0.7s ease-out 0.6s forwards;
  }
  .step{ display:flex; gap:18px; }
  .step-num{
    font-family:'Fraunces', serif;
    font-size:1.3rem;
    font-weight:600;
    color:var(--accent);
    width:24px;
    flex-shrink:0;
  }
  .step-text strong{
    display:block;
    color:var(--white);
    font-weight:600;
    font-size:1.08rem;
    margin-bottom:4px;
  }
  .step-text span{
    color:#C3D4EE;
    font-size:0.96rem;
    line-height:1.55;
    display:block;
    max-width:420px;
  }

  .hero-divider{
    margin:50px 0 38px;
    height:1px;
    width:100%;
    background:rgba(255,255,255,0.16);
    opacity:0;
    animation: rise 0.7s ease-out 0.7s forwards;
  }

  .hero-question{
    opacity:0;
    animation: rise 0.7s ease-out 0.78s forwards;
  }

  .hero-question p{
    font-size:1.24rem;
    color:var(--white);
    margin-bottom:18px;
  }

  .btn-secondary{
    background:transparent;
    color:var(--white);
    border:1.5px solid rgba(255,255,255,0.45) !important;
    padding:14px 28px;
    border-radius:8px;
    font-size:1.04rem;
    font-weight:500;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .btn-secondary:hover{ border-color:var(--white) !important; background:rgba(255,255,255,0.08); }

  /* hero illustration */
  .hero-visual{
    display:flex;
    align-items:center;
    justify-content:center;
    opacity:0;
    animation: rise 0.9s ease-out 0.3s forwards;
  }
  .hero-visual svg{ width:100%; max-width:400px; height:auto; }

  /* ---------- PAGE 2: FORM ---------- */

  #page-form{
    padding:56px 24px 100px;
    min-height:100vh;
  }

  .form-shell{
    max-width:620px;
    margin:0 auto;
  }

  .form-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:28px;
  }

  .back-link{
    background:none;
    color:var(--blue);
    font-size:1.02rem;
    font-weight:500;
    padding:0;
    display:flex;
    align-items:center;
    gap:6px;
  }
  .back-link:hover{ color:var(--blue-mid); }

  .form-head{
    display:flex;
    align-items:flex-start;
    gap:24px;
    margin-bottom:14px;
  }

  .form-head svg{ width:70px; height:70px; flex-shrink:0; margin-top:4px; }

  .form-title{
    font-size:2.05rem;
    color:var(--navy-deep);
    margin-bottom:10px;
  }

  .form-lede{
    color:var(--ink-soft);
    font-size:1.08rem;
    line-height:1.6;
    margin-bottom:18px;
  }

  .form-note{
    background:var(--white);
    border:1px solid var(--paper-line);
    border-left:4px solid var(--accent);
    border-radius:8px;
    padding:18px 20px;
    font-size:0.96rem;
    color:var(--ink-soft);
    line-height:1.6;
    margin-bottom:38px;
  }
  .form-note strong{ color:var(--navy); font-weight:600; }

  .field{
    margin-bottom:28px;
    padding-bottom:28px;
    border-bottom:1px solid var(--paper-line);
  }
  .field:last-of-type{ border-bottom:none; }

  .field label{
    display:block;
    font-size:1.08rem;
    font-weight:600;
    color:var(--navy);
    margin-bottom:10px;
  }

  .field .hint{
    display:block;
    font-weight:400;
    font-size:0.92rem;
    color:var(--ink-soft);
    margin-top:4px;
  }

  .field input[type="number"],
  .field select{
    width:100%;
    padding:13px 15px;
    font-size:1.08rem;
    font-family:'Inter', sans-serif;
    color:var(--ink);
    background:var(--white);
    border:1.5px solid var(--paper-line);
    border-radius:6px;
    transition: border-color 0.15s ease;
  }
  .field input[type="number"]:focus,
  .field select:focus{
    border-color:var(--blue-mid);
  }

  .field-inline{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .field-inline input[type="number"]{ max-width:130px; }
  .field-inline .unit{ color:var(--ink-soft); font-size:0.98rem; }

  .btn-calc{
    width:100%;
    background:var(--blue);
    color:var(--white);
    padding:17px;
    border-radius:8px;
    font-size:1.1rem;
    font-weight:600;
    margin-top:8px;
    transition: background 0.15s ease;
  }
  .btn-calc:hover{ background:var(--blue-mid); }

  /* ---------- RESULT PLACEHOLDER ---------- */

  #result-block{
    position:relative;
    margin-top:42px;
    padding:30px;
    background:var(--white);
    border:1px solid var(--paper-line);
    border-radius:10px;
    overflow:hidden;
  }

  .result-books{
    position:absolute;
    top:14px; right:14px;
    width:64px; height:auto;
    opacity:0.9;
  }

  #result-block .result-label{
    font-size:1rem;
    color:var(--ink-soft);
    margin-bottom:14px;
    max-width:75%;
  }

  .result-row{
    display:flex;
    align-items:baseline;
    gap:8px;
    margin-bottom:18px;
  }

  #result-percent{
    font-family:'Fraunces', serif;
    font-size:3rem;
    color:var(--navy-deep);
  }
  #result-percent::after{
    content:"%";
    font-size:1.7rem;
    color:var(--ink-soft);
  }

  .meter{
    height:11px;
    width:100%;
    background:var(--paper-line);
    border-radius:999px;
    overflow:hidden;
  }
  #meter-fill{
    height:100%;
    width:0%;
    background:linear-gradient(90deg, var(--danger), var(--accent), var(--ok));
    border-radius:999px;
    transition: width 0.5s ease;
  }

  .result-hint{
    margin-top:16px;
    font-size:0.96rem;
    color:var(--ink-soft);
    line-height:1.55;
  }

  @media (max-width:520px){
    #page-hero{ padding:56px 20px; }
    #page-form{ padding:40px 18px 80px; }
    .form-head{ flex-direction:column; }
    .form-head svg{ width:56px; height:56px; }
  }
</style>
</head>
<body>

<!-- =================== СТРАНИЦА 1: ДЛЯ УЧИТЕЛЯ =================== -->
<section id="page-hero" class="page active">
  <div class="hero-shell">

    <div class="hero-text">
      <div class="brand-badge">
        <svg class="laurel" viewBox="0 0 240 100" fill="none" aria-hidden="true">
          <g stroke="var(--blue-tint)" stroke-width="2" opacity="0.6">
            <path d="M22 92 Q10 60 26 30 Q37 8 58 3"/>
            <ellipse cx="24" cy="80" rx="7" ry="3" transform="rotate(-30 24 80)" fill="var(--blue-tint)"/>
            <ellipse cx="19" cy="64" rx="7" ry="3" transform="rotate(-12 19 64)" fill="var(--blue-tint)"/>
            <ellipse cx="21" cy="48" rx="7" ry="3" transform="rotate(4 21 48)" fill="var(--blue-tint)"/>
            <ellipse cx="30" cy="32" rx="7" ry="3" transform="rotate(24 30 32)" fill="var(--blue-tint)"/>
            <ellipse cx="45" cy="17" rx="7" ry="3" transform="rotate(48 45 17)" fill="var(--blue-tint)"/>
          </g>
          <g stroke="var(--blue-tint)" stroke-width="2" opacity="0.6" transform="translate(240,0) scale(-1,1)">
            <path d="M22 92 Q10 60 26 30 Q37 8 58 3"/>
            <ellipse cx="24" cy="80" rx="7" ry="3" transform="rotate(-30 24 80)" fill="var(--blue-tint)"/>
            <ellipse cx="19" cy="64" rx="7" ry="3" transform="rotate(-12 19 64)" fill="var(--blue-tint)"/>
            <ellipse cx="21" cy="48" rx="7" ry="3" transform="rotate(4 21 48)" fill="var(--blue-tint)"/>
            <ellipse cx="30" cy="32" rx="7" ry="3" transform="rotate(24 30 32)" fill="var(--blue-tint)"/>
            <ellipse cx="45" cy="17" rx="7" ry="3" transform="rotate(48 45 17)" fill="var(--blue-tint)"/>
          </g>
        </svg>
        <span class="brand">Допуск</span>
      </div>

      <h1 class="hero-greeting">Привет. Разберёмся, как у твоих учеников дела с сессией.</h1>
      <p class="hero-sub">
        Установи приложение, чтобы проверить, с кем из ваших учеников нужно провести беседу,
        чтобы он обратил особое внимание на подготовку к сессии.
      </p>

      <a id="download-btn" class="btn-primary" href="data:text/plain;charset=utf-8,%D0%AD%D1%82%D0%BE%20%D0%B7%D0%B0%D0%B3%D0%BB%D1%83%D1%88%D0%BA%D0%B0.%20%D0%97%D0%B0%D0%BC%D0%B5%D0%BD%D0%B8%D1%82%D0%B5%20%D1%81%D1%81%D1%8B%D0%BB%D0%BA%D1%83%20%D0%BD%D0%B0%20%D1%80%D0%B5%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B9%20%D1%84%D0%B0%D0%B9%D0%BB%20%D0%BF%D1%80%D0%B8%D0%BB%D0%BE%D0%B6%D0%B5%D0%BD%D0%B8%D1%8F." download="dopusk-placeholder.txt">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Скачать приложение
      </a>
      <div class="download-note">Загрузится файл-заглушка — замени ссылку на реальный установщик.</div>

      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <div class="step-text">
            <strong>Вносишь данные</strong>
            <span>Заполняешь таблицу по своим ученикам: посещаемость, баллы за контрольные, часы самоподготовки.</span>
          </div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div class="step-text">
            <strong>Получаешь прогноз</strong>
            <span>Приложение считает вероятность успешной сдачи сессии для каждого ученика в списке.</span>
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div class="step-text">
            <strong>Разговариваешь вовремя</strong>
            <span>Видишь, у кого риск выше, и успеваешь обсудить подготовку до начала сессии, а не после.</span>
          </div>
        </div>
      </div>

      <div class="hero-divider"></div>

      <div class="hero-question">
        <p>А ученик хочет сам посмотреть свои шансы?</p>
        <button class="btn-secondary" onclick="goToForm()">Проверить свой шанс</button>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <svg viewBox="0 0 400 300" fill="none">
        <path d="M40 96 L200 24 L360 96" stroke="var(--blue-tint)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="28" y1="96" x2="372" y2="96" stroke="var(--blue-tint)" stroke-width="4" stroke-linecap="round"/>
        <circle cx="200" cy="16" r="6" fill="var(--accent)"/>
        <line x1="70"  y1="102" x2="70"  y2="212" stroke="var(--blue-mid)" stroke-width="8" stroke-linecap="round"/>
        <line x1="130" y1="102" x2="130" y2="212" stroke="var(--blue-mid)" stroke-width="8" stroke-linecap="round"/>
        <line x1="190" y1="102" x2="190" y2="212" stroke="var(--blue-mid)" stroke-width="8" stroke-linecap="round"/>
        <line x1="250" y1="102" x2="250" y2="212" stroke="var(--blue-mid)" stroke-width="8" stroke-linecap="round"/>
        <line x1="310" y1="102" x2="310" y2="212" stroke="var(--blue-mid)" stroke-width="8" stroke-linecap="round"/>
        <line x1="24"  y1="222" x2="376" y2="222" stroke="var(--blue-tint)" stroke-width="5" stroke-linecap="round"/>
        <line x1="12"  y1="240" x2="388" y2="240" stroke="var(--blue-tint)" stroke-width="5" stroke-linecap="round" opacity="0.7"/>
        <line x1="0"   y1="258" x2="400" y2="258" stroke="var(--blue-tint)" stroke-width="5" stroke-linecap="round" opacity="0.45"/>
      </svg>
    </div>

  </div>
</section>

<!-- =================== СТРАНИЦА 2: ДЛЯ УЧЕНИКА =================== -->
<section id="page-form" class="page">
  <div class="form-shell">

    <div class="form-top">
      <button class="back-link" onclick="goToHero()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Назад
      </button>
    </div>

    <div class="form-head">
      <svg viewBox="0 0 200 160" fill="none">
        <polygon points="100,26 178,58 100,90 22,58" fill="var(--blue-mid)"/>
        <circle cx="100" cy="58" r="6" fill="var(--navy-deep)"/>
        <line x1="100" y1="58" x2="128" y2="108" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/>
        <circle cx="128" cy="114" r="6" fill="var(--accent)"/>
        <ellipse cx="100" cy="98" rx="52" ry="14" fill="var(--blue-tint)" opacity="0.6"/>
      </svg>
      <div>
        <h2 class="form-title">Узнай свой шанс сдать сессию</h2>
        <p class="form-lede">
          Ответь на несколько вопросов о своём семестре — по этим же данным преподаватели
          в приложении видят прогноз по всей группе. Это не приговор, а повод понять,
          на что стоит обратить внимание за оставшееся время.
        </p>
      </div>
    </div>

    <div class="form-note">
      <strong>Что мы учитываем:</strong> посещаемость, результаты двух промежуточных контрольных,
      время самостоятельной подготовки, количество незачётов и то, сколько остаётся сил и времени
      на отдых с друзьями — учёба редко существует отдельно от всего остального.
    </div>

    <form id="check-form" onsubmit="return false;">

      <div class="field">
        <label for="attendance">Посещаемость
          <span class="hint">Сколько занятий из семестра ты посетил</span>
        </label>
        <div class="field-inline">
          <input type="number" id="attendance" name="attendance" min="0" placeholder="24">
          <span class="unit">занятий</span>
        </div>
      </div>

      <div class="field">
        <label for="test1">Балл за 1-ю промежуточную контрольную
          <span class="hint">Оценка по шкале, принятой у вас на курсе</span>
        </label>
        <input type="number" id="test1" name="test1" min="0" placeholder="Например, 75">
      </div>

      <div class="field">
        <label for="test2">Балл за 2-ю промежуточную контрольную
          <span class="hint">Оценка по шкале, принятой у вас на курсе</span>
        </label>
        <input type="number" id="test2" name="test2" min="0" placeholder="Например, 68">
      </div>

      <div class="field">
        <label for="selfStudy">Самостоятельные занятия
          <span class="hint">Сколько часов в неделю ты занимаешься сам</span>
        </label>
        <div class="field-inline">
          <input type="number" id="selfStudy" name="selfStudy" min="0" placeholder="5">
          <span class="unit">ч / нед</span>
        </div>
      </div>

      <div class="field">
        <label for="failCount">Незачёты
          <span class="hint">Сколько всего незачётов накопилось за семестр</span>
        </label>
        <input type="number" id="failCount" name="failCount" min="0" placeholder="0">
      </div>

      <div class="field">
        <label for="friends">Общение с друзьями
          <span class="hint">Как часто ты видишься с друзьями в обычную неделю</span>
        </label>
        <select id="friends" name="friends">
          <option value="">Выбери вариант</option>
          <option value="often">Часто</option>
          <option value="sometimes">Иногда</option>
          <option value="rarely">Редко</option>
          <option value="never">Никогда</option>
        </select>
      </div>

      <button type="button" class="btn-calc" onclick="calculateProbability()">Рассчитать вероятность</button>
    </form>

    <!-- ===== БЛОК РЕЗУЛЬТАТА ===== -->
    <div id="result-block">
      <svg class="result-books" viewBox="0 0 120 90" fill="none" aria-hidden="true">
        <rect x="10" y="60" width="90" height="14" rx="3" fill="var(--blue-tint)"/>
        <rect x="18" y="44" width="74" height="14" rx="3" fill="var(--blue-mid)"/>
        <rect x="26" y="28" width="58" height="14" rx="3" fill="var(--blue)"/>
        <rect x="34" y="12" width="42" height="12" rx="3" fill="var(--accent)"/>
      </svg>
      <div class="result-label">Вероятность сдать сессию</div>
      <div class="result-row">
        <span id="result-percent">—</span>
      </div>
      <div class="meter"><div id="meter-fill"></div></div>
      <p class="result-hint" id="result-hint">Заполни форму и нажми «Рассчитать вероятность».</p>
    </div>

  </div>
</section>

<script>
  function goToForm(){
    document.getElementById('page-hero').classList.remove('active');
    document.getElementById('page-form').classList.add('active');
    window.scrollTo(0,0);
  }

  function goToHero(){
    document.getElementById('page-form').classList.remove('active');
    document.getElementById('page-hero').classList.add('active');
    window.scrollTo(0,0);
  }

  /*
    ==========================================================
    РАСЧЁТ ВЕРОЯТНОСТИ — ЗАГЛУШКА
    ==========================================================
    Ниже собраны значения всех полей формы. Логику подсчёта
    процента (formula/модель/что угодно) добавь сама(сам) —
    просто присвой итоговое число переменной `probability`
    (0–100) и вызови showResult(probability).

    Пример того, что уже доступно в переменной `answers`:
      answers.attendance   — посещённые занятия, количество
      answers.test1        — балл за 1-ю контрольную
      answers.test2        — балл за 2-ю контрольную
      answers.selfStudy    — часы самоподготовки в неделю
      answers.failCount    — количество незачётов
      answers.friends      — 'often' | 'sometimes' | 'rarely' | 'never'
  */
  function calculateProbability(){
    const answers = {
      attendance: Number(document.getElementById('attendance').value),
      test1: Number(document.getElementById('test1').value),
      test2: Number(document.getElementById('test2').value),
      selfStudy: Number(document.getElementById('selfStudy').value),
      failCount: Number(document.getElementById('failCount').value),
      friends: document.getElementById('friends').value
    };

    // TODO: замени строку ниже на свою логику расчёта
    let probability = null;

    if (probability === null){
      // временная заглушка, чтобы кнопка не была немой при демонстрации
      probability = 0;
      showResult(probability, true);
      return;
    }

    showResult(probability, false);
  }

  function showResult(probability, isPlaceholder){
    const percentEl = document.getElementById('result-percent');
    const fillEl = document.getElementById('meter-fill');
    const hintEl = document.getElementById('result-hint');

    percentEl.textContent = probability;
    fillEl.style.width = probability + '%';

    if (isPlaceholder){
      hintEl.textContent = 'Логика расчёта ещё не подключена — добавь её в функции calculateProbability().';
    } else if (probability >= 70){
      hintEl.textContent = 'Хороший результат. Продолжай в том же духе.';
    } else if (probability >= 40){
      hintEl.textContent = 'Есть над чем поработать до конца сессии.';
    } else {
      hintEl.textContent = 'Стоит пересмотреть подготовку — время ещё есть.';
    }
  }
</script>

</body>
</html>
