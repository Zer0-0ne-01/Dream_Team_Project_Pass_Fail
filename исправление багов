<script>
  // ===== NAVIGATION =====
  function goToHero() {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-hero').classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function goToTeacher() {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-teacher').classList.add('active');
    const target = document.getElementById('page-teacher');
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function goToStudent() {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-student').classList.add('active');
    const target = document.getElementById('page-student');
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ===== КОНСТАНТЫ =====
  const COLUMNS = [
    'school', 'sex', 'age', 'address', 'famsize', 'Pstatus',
    'Medu', 'Fedu', 'Mjob', 'Fjob', 'reason', 'guardian',
    'traveltime', 'studytime', 'failures', 'schoolsup', 'famsup',
    'paid', 'activities', 'nursery', 'higher', 'internet',
    'romantic', 'famrel', 'freetime', 'goout', 'Dalc', 'Walc',
    'health', 'absences', 'G1', 'G2', 'G3'
  ];

  const TEXT_COLUMNS = [
    'school', 'sex', 'address', 'famsize', 'Pstatus', 
    'Mjob', 'Fjob', 'reason', 'guardian', 'schoolsup', 
    'famsup', 'paid', 'activities', 'nursery', 'higher', 
    'internet', 'romantic'
  ];

  let rowData = [];
  let lastResults = [];
  let currentModalFilter = 'all';

  // ===== ИНИЦИАЛИЗАЦИЯ =====
  function initTable(rows = 20) {
    rowData = [];
    for (let i = 0; i < rows; i++) {
      const row = {};
      COLUMNS.forEach(col => row[col] = '');
      rowData.push(row);
    }
    renderTable();
    updateStatus('Таблица создана на ' + rows + ' строк');
  }

  // ===== ПРОВЕРКА, ЕСТЬ ЛИ В СТРОКЕ ХОТЯ БЫ ОДИН СИМВОЛ =====
  function isRowNonEmpty(row) {
    return COLUMNS.some(col => row[col] && row[col].trim() !== '');
  }

  // ===== ОТРИСОВКА ТАБЛИЦЫ =====
  function renderTable() {
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '';
    
    rowData.forEach((row, idx) => {
      const tr = document.createElement('tr');
      tr.dataset.index = idx;
      
      const tdNum = document.createElement('td');
      tdNum.className = 'row-num';
      tdNum.textContent = idx + 1;
      tr.appendChild(tdNum);

      COLUMNS.forEach(col => {
        const td = document.createElement('td');
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'table-input';
        if (TEXT_COLUMNS.includes(col)) {
          input.className += ' text';
        }
        input.value = row[col] || '';
        input.dataset.row = idx;
        input.dataset.col = col;
        input.addEventListener('input', function() {
          const r = parseInt(this.dataset.row);
          const c = this.dataset.col;
          rowData[r][c] = this.value;
          this.classList.remove('paste-highlight');
        });
        td.appendChild(input);
        tr.appendChild(td);
      });

      tbody.appendChild(tr);
    });

    document.getElementById('rowCount').textContent = rowData.length;
  }

  // ===== ДОБАВЛЕНИЕ СТРОК =====
  function addRows() {
    const countInput = document.getElementById('addCount');
    let count = parseInt(countInput.value) || 5;
    if (count < 1) count = 1;
    if (count > 100) count = 100;
    
    for (let i = 0; i < count; i++) {
      const row = {};
      COLUMNS.forEach(col => row[col] = '');
      rowData.push(row);
    }
    renderTable();
    updateStatus('Добавлено ' + count + ' строк. Всего: ' + rowData.length);
    showToast('✅ Добавлено ' + count + ' строк');
  }

  function addRow() {
    const row = {};
    COLUMNS.forEach(col => row[col] = '');
    rowData.push(row);
    renderTable();
    updateStatus('Добавлена 1 строка. Всего: ' + rowData.length);
  }

  // ===== УДАЛЕНИЕ СТРОК =====
  function deleteRows() {
    const countInput = document.getElementById('deleteCount');
    let count = parseInt(countInput.value) || 1;
    if (count < 1) count = 1;
    if (count > rowData.length) count = rowData.length;
    
    if (count === 0) {
      showToast('⚠️ В таблице нет строк для удаления');
      return;
    }
    
    if (!confirm('Удалить последние ' + count + ' строк?')) return;
    
    for (let i = 0; i < count; i++) {
      rowData.pop();
    }
    renderTable();
    updateStatus('Удалено ' + count + ' строк. Всего: ' + rowData.length);
    showToast('🗑️ Удалено ' + count + ' строк');
  }

  function deleteRow() {
    if (rowData.length <= 1) {
      showToast('⚠️ Нельзя удалить последнюю строку');
      return;
    }
    if (!confirm('Удалить последнюю строку?')) return;
    rowData.pop();
    renderTable();
    updateStatus('Удалена 1 строка. Всего: ' + rowData.length);
    showToast('🗑️ Строка удалена');
  }

  // ===== ОЧИСТКА =====
  function clearTable() {
    if (rowData.length === 0) {
      showToast('⚠️ Таблица уже пуста');
      return;
    }
    if (!confirm('Удалить все данные из таблицы?')) return;
    
    rowData.forEach(row => {
      COLUMNS.forEach(col => row[col] = '');
    });
    renderTable();
    updateStatus('Все данные очищены');
    showToast('🗑️ Все данные очищены');
  }

  // ===== ОБНОВЛЕНИЕ СТАТУСА =====
  function updateStatus(message) {
    document.getElementById('rowCount').textContent = rowData.length;
    if (message) {
      document.getElementById('lastAction').textContent = '✅ ' + message;
    }
  }

  // ===== КОПИРОВАНИЕ ТАБЛИЦЫ =====
  function copyTable() {
    if (rowData.length === 0) {
      showToast('⚠️ Таблица пуста! Нечего копировать.');
      return;
    }

    let tsv = '';
    tsv += '#' + '\t' + COLUMNS.join('\t') + '\n';
    
    rowData.forEach((row, idx) => {
      const values = COLUMNS.map(col => row[col] || '');
      tsv += (idx + 1) + '\t' + values.join('\t') + '\n';
    });

    navigator.clipboard.writeText(tsv).then(() => {
      showToast('✅ Таблица скопирована! Вставьте в Excel (Ctrl+V)');
      updateStatus('Таблица скопирована (' + rowData.length + ' строк)');
    }).catch(() => {
      const textarea = document.createElement('textarea');
      textarea.value = tsv;
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast('✅ Таблица скопирована! Вставьте в Excel (Ctrl+V)');
        updateStatus('Таблица скопирована (' + rowData.length + ' строк)');
      } catch (e) {
        showToast('❌ Ошибка копирования. Выделите таблицу вручную.');
      }
      document.body.removeChild(textarea);
    });
  }

  // ===== ВСТАВКА ИЗ EXCEL (Ctrl+V) =====
  document.addEventListener('paste', function(e) {
    const teacherPage = document.getElementById('page-teacher');
    if (!teacherPage.classList.contains('active')) return;
    
    const target = e.target;
    if (!target.classList.contains('table-input')) return;
    
    const clipboardData = e.clipboardData || window.clipboardData;
    if (!clipboardData) return;
    
    const text = clipboardData.getData('text/plain');
    if (!text) return;
    
    e.preventDefault();
    
    const rowIdx = parseInt(target.dataset.row);
    const colName = target.dataset.col;
    const colIdx = COLUMNS.indexOf(colName);
    
    const lines = text.split('\n').filter(line => line.trim() !== '');
    if (lines.length === 0) {
      showToast('⚠️ Нет данных для вставки');
      return;
    }
    
    let delimiter = '\t';
    if (lines[0].includes(';') && !lines[0].includes('\t')) {
      delimiter = ';';
    }
    
    const parsedData = lines.map(line => line.split(delimiter).map(cell => cell.trim()));
    
    let startRow = 0;
    const firstRow = parsedData[0];
    const headerKeywords = ['#', 'school', 'sex', 'age', 'address', 'famsize', 'Pstatus'];
    if (firstRow.some(cell => headerKeywords.some(keyword => cell.toLowerCase().includes(keyword)))) {
      startRow = 1;
    }
    
    const dataRows = parsedData.slice(startRow);
    if (dataRows.length === 0) {
      showToast('⚠️ Нет данных для вставки');
      return;
    }
    
    const rowsToInsert = dataRows.length;
    const colsToInsert = dataRows[0].length;
    
    const neededRows = rowIdx + rowsToInsert;
    let addedRows = 0;
    while (rowData.length < neededRows) {
      const row = {};
      COLUMNS.forEach(col => row[col] = '');
      rowData.push(row);
      addedRows++;
    }
    
    let filled = 0;
    
    for (let i = 0; i < rowsToInsert; i++) {
      const sourceRow = dataRows[i];
      const targetRow = rowData[rowIdx + i];
      for (let j = 0; j < colsToInsert; j++) {
        const colIndex = colIdx + j;
        if (colIndex < COLUMNS.length && j < sourceRow.length) {
          targetRow[COLUMNS[colIndex]] = sourceRow[j] || '';
          filled++;
        }
      }
    }
    
    renderTable();
    
    setTimeout(() => {
      const inputs = document.querySelectorAll('.table-input');
      inputs.forEach(inp => {
        const r = parseInt(inp.dataset.row);
        const c = inp.dataset.col;
        const colIndex = COLUMNS.indexOf(c);
        if (r >= rowIdx && r < rowIdx + rowsToInsert && 
            colIndex >= colIdx && colIndex < colIdx + colsToInsert) {
          inp.classList.add('paste-highlight');
          setTimeout(() => {
            inp.classList.remove('paste-highlight');
          }, 2000);
        }
      });
    }, 50);
    
    let message = `Вставлено ${rowsToInsert} строк`;
    if (colsToInsert > 1) message += ` (${colsToInsert} колонок)`;
    if (addedRows > 0) message += `, добавлено ${addedRows} новых строк`;
    
    updateStatus(message);
    showToast('✅ ' + message);
  });

  // ===== TOAST =====
  function showToast(message) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toast._timeout);
    toast._timeout = setTimeout(() => {
      toast.classList.remove('show');
    }, 4000);
  }

  // ===== CALCULATE RISK =====
  let calculatedStudents = [];

  function calculateTeacherRisk() {
    const nonEmptyRows = rowData.filter(row => isRowNonEmpty(row));
    
    if (nonEmptyRows.length === 0) {
      showToast('⚠️ Нет данных для расчёта. Заполните хотя бы одну строку.');
      return;
    }

    const students = nonEmptyRows.map((row, idx) => {
      const failures = parseFloat(row.failures) || 0;
      const absences = parseFloat(row.absences) || 0;
      const g1 = parseFloat(row.G1) || 0;
      const g2 = parseFloat(row.G2) || 0;
      const studytime = parseFloat(row.studytime) || 0;
      
      let risk = 0;
      risk += Math.min(failures * 20, 30);
      risk += Math.min(absences / 100 * 30, 30);
      const avgG = (g1 + g2) / 2;
      risk += Math.max(0, (20 - avgG) / 20 * 25);
      risk += Math.max(0, (5 - studytime) / 5 * 15);
      risk = Math.min(Math.round(risk), 100);
      
      const chance = 100 - risk;
      
      return { 
        id: idx + 1,
        school: row.school || 'GP',
        age: row.age || '?',
        chance: chance,
        risk: risk
      };
    });

    calculatedStudents = students;
    lastResults = students;

    const results = students.sort((a, b) => a.chance - b.chance);
    const high = results.filter(r => r.chance >= 70).length;
    const medium = results.filter(r => r.chance >= 40 && r.chance < 70).length;
    const low = results.filter(r => r.chance < 40).length;

    const total = results.length;

    document.getElementById('stat-total').textContent = total;
    document.getElementById('stat-high').textContent = high;
    document.getElementById('stat-medium').textContent = medium;
    document.getElementById('stat-low').textContent = low;

    document.getElementById('stat-high-bar').style.width = total > 0 ? (high / total * 100) + '%' : '0%';
    document.getElementById('stat-medium-bar').style.width = total > 0 ? (medium / total * 100) + '%' : '0%';
    document.getElementById('stat-low-bar').style.width = total > 0 ? (low / total * 100) + '%' : '0%';

    const resultDiv = document.getElementById('teacher-result');
    resultDiv.classList.add('active');

    const listDiv = document.getElementById('teacher-risk-list');
    listDiv.innerHTML = '';
    const topStudents = results.slice(0, 4);
    topStudents.forEach(s => {
      const div = document.createElement('div');
      div.className = 'risk-student';
      const level = s.chance >= 70 ? 'high' : (s.chance >= 40 ? 'medium' : 'low');
      div.innerHTML = `
        <span class="name">Студент #${s.id}</span>
        <span class="class">${s.school} ${s.age} лет</span>
        <div class="risk-bar"><div class="fill ${level}" style="width:${s.chance}%"></div></div>
        <span class="percent ${level}">${s.chance}%</span>
      `;
      listDiv.appendChild(div);
    });

    const badge = document.getElementById('result-badge');
    if (low > 0) {
      badge.textContent = `⚠️ ${low} студентов с низким шансом`;
      badge.className = 'badge low';
    } else if (medium > 0) {
      badge.textContent = `📊 ${medium} студентов со средним шансом`;
      badge.className = 'badge medium';
    } else {
      badge.textContent = '✅ У всех студентов высокий шанс';
      badge.className = 'badge high';
    }
    resultDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    showToast('📊 Расчёт выполнен!');
  }

  // ===== ALL STUDENTS MODAL =====
  function openAllStudentsModal(filter = 'all') {
    if (lastResults.length === 0) {
      showToast('⚠️ Сначала выполните расчёт ("Проверить шансы")');
      return;
    }
    currentModalFilter = filter;
    document.getElementById('allStudentsModal').classList.add('active');
    document.body.style.overflow = 'hidden';
    
    const titleMap = {
      'all': '📋 Все студенты',
      'high': '📋 Студенты с высоким шансом (≥70%)',
      'medium': '📋 Студенты со средним шансом (40-69%)',
      'low': '📋 Студенты с низким шансом (&lt;40%)'
    };
    document.getElementById('modalTitle').textContent = titleMap[filter] || '📋 Все студенты';
    
    const badgeMap = {
      'all': '',
      'high': '<span class="modal-badge high">Высокий шанс</span>',
      'medium': '<span class="modal-badge medium">Средний шанс</span>',
      'low': '<span class="modal-badge low">Низкий шанс</span>'
    };
    document.getElementById('modalFilterBadge').innerHTML = badgeMap[filter] || '';
    
    renderAllStudents();
  }

  function closeAllStudentsModal() {
    document.getElementById('allStudentsModal').classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  function renderAllStudents() {
    const sortValue = document.getElementById('sortFilter').value;
    const filter = currentModalFilter;
    
    let filtered = [...lastResults];
    
    if (filter === 'high') {
      filtered = filtered.filter(s => s.chance >= 70);
    } else if (filter === 'medium') {
      filtered = filtered.filter(s => s.chance >= 40 && s.chance < 70);
    } else if (filter === 'low') {
      filtered = filtered.filter(s => s.chance < 40);
    }
    
    if (sortValue === 'asc') {
      filtered.sort((a, b) => a.chance - b.chance);
    } else {
      filtered.sort((a, b) => b.chance - a.chance);
    }

    const container = document.getElementById('modalBody');
    
    if (filtered.length === 0) {
      container.innerHTML = '<div class="modal-empty">Нет студентов в этой категории</div>';
      return;
    }

    container.innerHTML = '';
    filtered.forEach(s => {
      const div = document.createElement('div');
      div.className = 'modal-student';
      const level = s.chance >= 70 ? 'high' : (s.chance >= 40 ? 'medium' : 'low');
      div.innerHTML = `
        <span class="name">Студент #${s.id}</span>
        <span class="class">${s.school} ${s.age} лет</span>
        <div class="risk-bar"><div class="fill ${level}" style="width:${s.chance}%"></div></div>
        <span class="percent ${level}">${s.chance}%</span>
      `;
      container.appendChild(div);
    });
  }

  document.getElementById('allStudentsModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeAllStudentsModal();
    }
  });

  // ===== STUDENT CALC =====
  function calculateStudentRisk() {
    const attendance = parseFloat(document.getElementById('s-attendance').value) || 0;
    const g1 = parseFloat(document.getElementById('s-g1').value) || 0;
    const g2 = parseFloat(document.getElementById('s-g2').value) || 0;
    const self = parseFloat(document.getElementById('s-self').value) || 0;
    const fails = parseFloat(document.getElementById('s-fails').value) || 0;

    let risk = 0;
    risk += Math.min(fails * 20, 30);
    risk += Math.max(0, (25 - attendance) / 25 * 25);
    const avgG = (g1 + g2) / 2;
    risk += Math.max(0, (20 - avgG) / 20 * 25);
    risk += Math.max(0, (6 - self) / 6 * 20);
    risk = Math.min(Math.round(risk), 100);
    
    const chance = 100 - risk;

    const resultDiv = document.getElementById('student-result');
    resultDiv.classList.add('active');

    document.getElementById('s-result-percent').textContent = chance;

    const statusEl = document.getElementById('s-result-status');
    const labelEl = document.getElementById('s-result-label');
    if (chance >= 70) {
      statusEl.textContent = 'Высокий шанс ✅';
      statusEl.className = 'status high';
      labelEl.textContent = 'Вероятность сдачи';
    } else if (chance >= 40) {
      statusEl.textContent = 'Средний шанс';
      statusEl.className = 'status medium';
      labelEl.textContent = 'Вероятность сдачи';
    } else {
      statusEl.textContent = 'Низкий шанс ⚠️';
      statusEl.className = 'status low';
      labelEl.textContent = 'Вероятность сдачи';
    }

    const avg = ((g1 + g2) / 2 / 20 * 5).toFixed(1);
    document.getElementById('s-stat-avg').textContent = avg;
    document.getElementById('s-stat-att').textContent = Math.min(Math.round(attendance / 25 * 100), 100) + '%';
    document.getElementById('s-stat-self').textContent = self + ' ч/нед';

    const tipsList = document.getElementById('s-tips-list');
    tipsList.innerHTML = '';
    const tips = [];
    if (attendance < 20) tips.push('Посещай занятия регулярно');
    if ((g1 + g2) / 2 < 12) tips.push('Больше практикуйся по темам');
    if (self < 3) tips.push('Увеличь время на самоподготовку');
    if (fails > 0) tips.push('Закрой незачёты как можно скорее');
    if (tips.length === 0) tips.push('Отличная работа! Продолжай в том же духе 🎉');
    tips.forEach(t => {
      const li = document.createElement('li');
      li.textContent = t;
      tipsList.appendChild(li);
    });

    resultDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ===== ЗАПУСК =====
  document.addEventListener('DOMContentLoaded', function() {
    initTable(20);
  });

  window.addEventListener('hashchange', function() {
    const hash = window.location.hash;
    if (hash === '#page-teacher') goToTeacher();
    else if (hash === '#page-student') goToStudent();
    else if (hash === '#page-hero' || hash === '') goToHero();
  });

  if (window.location.hash === '#page-teacher') goToTeacher();
  else if (window.location.hash === '#page-student') goToStudent();

  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey && e.shiftKey && (e.key === '+' || e.key === '=')) || 
        (e.ctrlKey && e.key === '=')) {
      e.preventDefault();
      addRow();
    }
    if ((e.ctrlKey && e.shiftKey && e.key === '-') || 
        (e.ctrlKey && e.key === '-')) {
      e.preventDefault();
      deleteRow();
    }
    if (e.ctrlKey && e.key === 'c' && !e.target.closest('input') && 
        document.getElementById('page-teacher').classList.contains('active')) {
      e.preventDefault();
      copyTable();
    }
    if (e.key === 'Escape') {
      closeAllStudentsModal();
    }
  });
</script>

