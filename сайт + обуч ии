  // (это и есть исправление бага несовпадения колонок get_dummies).
  const CAT_SCHEMA = {
    school:     { col_prefix: 'school',     values: ['MS'] },              // база: GP
    sex:        { col_prefix: 'sex',        values: ['M'] },               // база: F
    address:    { col_prefix: 'address',    values: ['U'] },               // база: R
