  const NUMERIC_FEATURES = [
    'age','Medu','Fedu','traveltime','studytime','failures',
    'famrel','freetime','goout','Dalc','Walc','health','absences','G1','G2'
  ];

  // FEATURE_ORDER — точный порядок 41 признака, как их увидела модель при обучении
  // (pandas.get_dummies даёт колонки в алфавитном порядке внутри каждой группы).
  const FEATURE_ORDER = ["age", "Medu", "Fedu", "traveltime", "studytime", "failures", "famrel", "freetime", "goout", "Dalc", "Walc", "health", "absences", "G1", "G2", "school_MS", "sex_M", "address_U", "famsize_LE3", "Pstatus_T", "Mjob_health", "Mjob_other", "Mjob_services", "Mjob_teacher", "Fjob_health", "Fjob_other", "Fjob_services", "Fjob_teacher", "reason_home", "reason_other", "reason_reputation", "guardian_mother", "guardian_other", "schoolsup_yes", "famsup_yes", "paid_yes", "activities_yes", "nursery_yes", "higher_yes", "internet_yes", "romantic_yes"];

  // Строит вектор признаков для одной строки таблицы (или объекта с теми же ключами),
  // строго в порядке FEATURE_ORDER. Отсутствующие/незнакомые значения → 0,
  // как и было бы у pandas.get_dummies с уже подогнанной схемой колонок.
  function buildFeatureVector(row) {
    const vec = {};
    NUMERIC_FEATURES.forEach(f => { vec[f] = parseFloat(row[f]) || 0; });

    Object.keys(CAT_SCHEMA).forEach(rawCol => {
      const schema = CAT_SCHEMA[rawCol];
      const rawVal = (row[rawCol] || '').toString().trim();
      schema.values.forEach(v => {
        const colName = schema.col_prefix + '_' + v;
        vec[colName] = (rawVal === v) ? 1 : 0;
      });
    });

    return FEATURE_ORDER.map(f => (f in vec ? vec[f] : 0));
  }

