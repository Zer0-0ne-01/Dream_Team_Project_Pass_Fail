<!-- CUSTOM CONFIRM MODAL (замена браузерного confirm(), который блокируется в iframe) -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal-content" style="max-width:420px;">
    <div class="modal-header">
      <h2 style="font-size:1.15rem;">⚠️ Подтверждение</h2>
    </div>
    <div class="modal-body" style="padding:20px 24px;">
      <p id="confirmModalText" style="color:var(--ink-soft); font-size:1rem; line-height:1.5; margin:0 0 20px;">Вы уверены?</p>
      <div style="display:flex; gap:12px; justify-content:flex-end;">
        <button class="btn" style="background:var(--paper-line); color:var(--ink);" onclick="_confirmModalResolve(false)">Отмена</button>
        <button class="btn btn-danger" onclick="_confirmModalResolve(true)">Подтвердить</button>
      </div>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
  // ===== CUSTOM CONFIRM (замена window.confirm) =====
  // window.confirm() — блокирующий диалог браузера. Он не работает (тихо
  // возвращает false) внутри iframe без разрешения allow-modals — именно
  // поэтому "Очистить всё" и "Удалить" не срабатывали при предпросмотре.
  // Этот модал — обычный HTML/CSS/JS, работает одинаково везде: и в iframe,
  // и при открытии файла напрямую в браузере, и на любом хостинге.
  let _confirmModalResolve = null;

  function customConfirm(message) {
    return new Promise((resolve) => {
      document.getElementById('confirmModalText').textContent = message;
      document.getElementById('confirmModal').classList.add('active');
      document.body.style.overflow = 'hidden';
      _confirmModalResolve = (result) => {
        document.getElementById('confirmModal').classList.remove('active');
        document.body.style.overflow = 'auto';
        _confirmModalResolve = null;
        resolve(result);
      };
    });
  }

  document.getElementById('confirmModal').addEventListener('click', function(e) {
    if (e.target === this && _confirmModalResolve) {
      _confirmModalResolve(false);
    }
  });

  // ===== NAVIGATION =====
  function goToHero() {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-hero').classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function goToTeacher() {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-teacher').classList.add('active');
    const target = document.getElementById('page-teacher');
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function goToStudent() {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-student').classList.add('active');
    const target = document.getElementById('page-student');
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ===== КОНСТАНТЫ =====
  const COLUMNS = [
    'school', 'sex', 'age', 'address', 'famsize', 'Pstatus',
    'Medu', 'Fedu', 'Mjob', 'Fjob', 'reason', 'guardian',
    'traveltime', 'studytime', 'failures', 'schoolsup', 'famsup',
    'paid', 'activities', 'nursery', 'higher', 'internet',
    'romantic', 'famrel', 'freetime', 'goout', 'Dalc', 'Walc',
    'health', 'absences', 'G1', 'G2', 'G3'
  ];

  const TEXT_COLUMNS = [
    'school', 'sex', 'address', 'famsize', 'Pstatus', 
    'Mjob', 'Fjob', 'reason', 'guardian', 'schoolsup', 
    'famsup', 'paid', 'activities', 'nursery', 'higher', 
    'internet', 'romantic'
  ];

  let rowData = [];
  let lastResults = [];
  let currentModalFilter = 'all';

  // ===== ИНИЦИАЛИЗАЦИЯ =====
  function initTable(rows = 20) {
    rowData = [];
    for (let i = 0; i < rows; i++) {
      const row = {};
      COLUMNS.forEach(col => row[col] = '');
      rowData.push(row);
    }
    renderTable();
    updateStatus('Таблица создана на ' + rows + ' строк');
  }

  // ===== ПРОВЕРКА, ЕСТЬ ЛИ В СТРОКЕ ХОТЯ БЫ ОДИН СИМВОЛ =====
  function isRowNonEmpty(row) {
    return COLUMNS.some(col => row[col] && row[col].trim() !== '');
  }

  // ===== ОТРИСОВКА ТАБЛИЦЫ =====
  function renderTable() {
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '';
    
    rowData.forEach((row, idx) => {
      const tr = document.createElement('tr');
      tr.dataset.index = idx;
      
      const tdNum = document.createElement('td');
      tdNum.className = 'row-num';
      tdNum.textContent = idx + 1;
      tr.appendChild(tdNum);

      COLUMNS.forEach(col => {
        const td = document.createElement('td');
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'table-input';
        if (TEXT_COLUMNS.includes(col)) {
          input.className += ' text';
        }
        input.value = row[col] || '';
        input.dataset.row = idx;
        input.dataset.col = col;
        input.addEventListener('input', function() {
          const r = parseInt(this.dataset.row);
          const c = this.dataset.col;
          rowData[r][c] = this.value;
          this.classList.remove('paste-highlight');
        });
        td.appendChild(input);
        tr.appendChild(td);
      });

      tbody.appendChild(tr);
    });

    document.getElementById('rowCount').textContent = rowData.length;
  }

  // ===== ДОБАВЛЕНИЕ СТРОК =====
  function addRows() {
    const countInput = document.getElementById('addCount');
    let count = parseInt(countInput.value) || 5;
    if (count < 1) count = 1;
    if (count > 100) count = 100;
    
    for (let i = 0; i < count; i++) {
      const row = {};
      COLUMNS.forEach(col => row[col] = '');
      rowData.push(row);
    }
    renderTable();
    updateStatus('Добавлено ' + count + ' строк. Всего: ' + rowData.length);
    showToast('✅ Добавлено ' + count + ' строк');
  }

  function addRow() {
    const row = {};
    COLUMNS.forEach(col => row[col] = '');
    rowData.push(row);
    renderTable();
    updateStatus('Добавлена 1 строка. Всего: ' + rowData.length);
